# ============================================================================== #
#                    agent-mesh - ENVIRONMENT CONFIGURATION TEMPLATE             #
# ============================================================================== #
#                                                                                #
#  This template centralizes all configuration variables, credentials, and       #
#  runtime toggles used across the Vitoria Rodrigues Agent Mesh monorepo.        #
#                                                                                #
#  INSTRUCTIONS:                                                                 #
#  1. Copy this file to .env in your active workspace (e.g. agent-mesh/.env).   #
#  2. Never commit .env to version control (.gitignore enforces this invariant). #
#  3. Populate placeholders (<YOUR_*>) with your local workstation values.       #
#                                                                                #
# ============================================================================== #


# ------------------------------------------------------------------------------ #
# 1. GITHUB MACHINE IDENTITY & REPOSITORY GOVERNANCE
# ------------------------------------------------------------------------------ #

# -- GitHub Organization Identifier
GITHUB_ORG=Vitoria-Rodrigues

# -- Tier 1: vitoria-rodrigues-org-manager (Administrative Headless Machine Identity)
# Primary authentication mechanism for GitHub organization management and agent mesh governance.
# In GitHub Actions Organization Secrets: ORG_MANAGER_APP_ID and ORG_MANAGER_APP_PRIVATE_KEY.
# Note: GitHub strictly forbids secrets starting with 'GITHUB_'. Prefix-less names are mandatory.
# Obtained from: https://github.com/organizations/Vitoria-Rodrigues/settings/apps/vitoria-rodrigues-org-manager
ORG_MANAGER_APP_ID=<YOUR_ORG_MANAGER_APP_ID>
ORG_MANAGER_APP_CLIENT_ID=<YOUR_ORG_MANAGER_APP_CLIENT_ID>
ORG_MANAGER_APP_INSTALLATION_ID=<YOUR_ORG_MANAGER_APP_INSTALLATION_ID>
# Private Key Format: Base64-encoded string (recommended for .env) OR path to local/mounted .pem file.
ORG_MANAGER_APP_PRIVATE_KEY_BASE64=<YOUR_ORG_MANAGER_APP_PRIVATE_KEY_BASE64>
ORG_MANAGER_APP_PRIVATE_KEY_PATH=<YOUR_ORG_MANAGER_APP_PRIVATE_KEY_PATH>

# -- Tier 2: vitoria-rodrigues-ci-bot (Autonomous Continuous Delivery Identity)
# Primary authentication for high-volume automated publishing, releases, and dependency PRs.
# In GitHub Actions Organization Secrets: CI_BOT_APP_ID and CI_BOT_APP_PRIVATE_KEY.
# Note: GitHub strictly forbids secrets starting with 'GITHUB_'. Prefix-less names are mandatory.
# Obtained from: https://github.com/organizations/Vitoria-Rodrigues/settings/apps/vitoria-rodrigues-ci-bot
CI_BOT_APP_ID=<YOUR_CI_BOT_APP_ID>
CI_BOT_APP_CLIENT_ID=<YOUR_CI_BOT_APP_CLIENT_ID>
CI_BOT_APP_INSTALLATION_ID=<YOUR_CI_BOT_APP_INSTALLATION_ID>
# Private Key Format: Base64-encoded string (recommended for .env) OR path to local/mounted .pem file.
CI_BOT_APP_PRIVATE_KEY_BASE64=<YOUR_CI_BOT_APP_PRIVATE_KEY_BASE64>
CI_BOT_APP_PRIVATE_KEY_PATH=<YOUR_CI_BOT_APP_PRIVATE_KEY_PATH>

# -- Tier 3: vitoria-rodrigues-developer-tools (Developer Workstation Identity)
# Public Client ID used by developers during OAuth 2.0 Device Authorization Flow (gh-tl CLI).
# Note: Public client identifier; zero private keys are used or generated for Tier 3.
# Obtained from: https://github.com/organizations/Vitoria-Rodrigues/settings/apps/vitoria-rodrigues-developer-tools
DEVELOPER_TOOLS_APP_ID=<YOUR_DEVELOPER_TOOLS_APP_ID>
DEVELOPER_TOOLS_APP_CLIENT_ID=<YOUR_DEVELOPER_TOOLS_APP_CLIENT_ID>

# -- Fallback Personal Access Token (PAT)
# Used for local development and emergency operations if GitHub App credentials are not set.
# Required Scopes: Contents (R/W), Issues (R/W), Pull Requests (R/W), Members (R)
GITHUB_TOKEN=<YOUR_GITHUB_TOKEN>

# -- Git Commit Cryptographic Signing Policy Toggle
# Values: 1 (enforce SSH signing when key configured) | 0 (bypass signing check)
GIT_REQUIRE_SIGNING=<YOUR_GIT_REQUIRE_SIGNING>

# -- GitHub Flow Safety Override Toggle
# Values: 0 (enforce branch protection & signing invariants) | 1 (bypass pre-tool-use hook)
MESH_ALLOW_UNSAFE_GIT=<YOUR_MESH_ALLOW_UNSAFE_GIT>


# ------------------------------------------------------------------------------ #
# 2. RESEARCH & KNOWLEDGE ENGINE (Context7 & Firecrawl)
# ------------------------------------------------------------------------------ #

# -- Context7 MCP Server (Live Framework & Library Documentation)
# Up-to-date upstream documentation for npm, PyPI, Go, and crates without LLM training drift.
# Obtain from: https://context7.ai
CONTEXT7_API_KEY=<YOUR_CONTEXT7_API_KEY>

# -- Firecrawl MCP Server (Deep Web Scraping & Clean Markdown Extraction)
# Scrapes documentation sites, blog posts, and dynamic single-page web applications.
# Obtain from: https://firecrawl.dev
FIRECRAWL_API_KEY=<YOUR_FIRECRAWL_API_KEY>

# -- Native Web Tools Bypass Toggle
# Values: 0 (enforce Firecrawl & Context7 usage) | 1 (allow generic search_web/read_url)
MESH_ALLOW_NATIVE_WEB=<YOUR_MESH_ALLOW_NATIVE_WEB>


# ------------------------------------------------------------------------------ #
# 3. PLAYWRIGHT BROWSER AUTOMATION & DESKTOP PAIRING
# ------------------------------------------------------------------------------ #

# -- Playwright Execution Mode Toggle
# Modes:
#   auto      - Connects to browser extension if token exists; otherwise falls back to headless.
#   extension - Connects directly to the developer's open browser session via Playwright Extension.
#   headless  - Runs in an isolated, background Chromium sandbox (zero desktop window interaction).
#   channel   - Launches system-installed browser (chrome, msedge, vivaldi) via OS registry lookup.
#   cdp       - Connects to an existing Chrome DevTools Protocol endpoint (e.g. port 9222).
PLAYWRIGHT_MODE=<YOUR_PLAYWRIGHT_MODE>

# -- Playwright MCP Browser Extension Security Token
# Secret token displayed in the Playwright Browser Extension (Chrome/Edge/Vivaldi/Brave).
# Bypasses the interactive manual confirmation dialog on each connection.
# Obtain by clicking the extension icon in your browser toolbar.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=<YOUR_PLAYWRIGHT_MCP_EXTENSION_TOKEN>

# -- Native Browser Channel (Used when PLAYWRIGHT_MODE=channel)
# Supported values: chrome, msedge, vivaldi, chromium
PLAYWRIGHT_CHANNEL=<YOUR_PLAYWRIGHT_CHANNEL>

# -- Headless Sandbox Flag (Used when running in channel or standalone modes)
# Values: true | false
PLAYWRIGHT_HEADLESS=<YOUR_PLAYWRIGHT_HEADLESS>

# -- Chrome DevTools Protocol (CDP) Remote Debugging Endpoint
# Default local loopback port for browsers launched with --remote-debugging-port=9222
PLAYWRIGHT_CDP_URL=<YOUR_PLAYWRIGHT_CDP_URL>

# -- Custom Browser Executable Path (Optional)
# Explicit path to target browser executable (e.g. Vivaldi, Brave, Canary, custom Chromium)
PLAYWRIGHT_MCP_EXECUTABLE_PATH=<YOUR_PLAYWRIGHT_MCP_EXECUTABLE_PATH>


# ------------------------------------------------------------------------------ #
# 4. LINKEDIN SUITE & CANDIDATE TALENT ENGINE
# ------------------------------------------------------------------------------ #

# -- LinkedIn Execution Engine Toggle
# Modes:
#   native   - Self-contained dual-transport in-house bundle (dist/bin.cjs on Stdio or Fastify :8080).
#   upstream - Directly delegates to 'uvx mcp-server-linkedin@latest' with auto-imported browser sessions.
LINKEDIN_ENGINE=<YOUR_LINKEDIN_ENGINE>

# -- Force Upstream Runner Flag
# Values: true | false
LINKEDIN_USE_UPSTREAM=<YOUR_LINKEDIN_USE_UPSTREAM>

# -- Upstream Cookie Import Browser Target
# Browser for local session auto-import: auto | chrome | msedge | brave | vivaldi | chromium
LINKEDIN_BROWSER=<YOUR_LINKEDIN_BROWSER>

# -- Upstream Headless Mode
# Values: true (background headless execution) | false (visible browser GUI window)
LINKEDIN_HEADLESS=<YOUR_LINKEDIN_HEADLESS>

# -- Candidate Resumes Storage Directory
# Directory storing candidate resume vault (.md, .txt, .pdf) for semantic ATS matching.
# Defaults to $PLUGIN_DATA/resumes if unset.
LINKEDIN_RESUMES_DIR=<YOUR_LINKEDIN_RESUMES_DIR>

# -- LinkedIn Session Cookie (li_at)
# Raw session cookie value for headless authentication if browser auto-import is bypassed.
LINKEDIN_SESSION_COOKIE=<YOUR_LINKEDIN_SESSION_COOKIE>

# -- LinkedIn Candidate Account Email
# Primary email associated with candidate LinkedIn profile for application pre-filling.
LINKEDIN_ACCOUNT_EMAIL=<YOUR_LINKEDIN_ACCOUNT_EMAIL>

# -- Upstream Custom Browser Profile Directory (Optional)
# Custom persistent directory for the browser profile.
LINKEDIN_USER_DATA_DIR=<YOUR_LINKEDIN_USER_DATA_DIR>


# ------------------------------------------------------------------------------ #
# 5. CORTEX MEMORY SYSTEM
# ------------------------------------------------------------------------------ #

# -- Cortex Memory REST API Endpoint
# Base URL of the memory-api Fastify service (e.g. http://localhost:3006 or http://memory-api:3006).
MEMORY_API_URL=<YOUR_MEMORY_API_URL>

# -- Cortex Memory MCP Server Listen Port
# Port for the local Memory MCP Fastify HTTP adapter (default: 8080 or 9007).
MEMORY_MCP_PORT=<YOUR_MEMORY_MCP_PORT>


# ------------------------------------------------------------------------------ #
# 6. ATELIER DOMAIN GOVERNANCE & ENFORCEMENT
# ------------------------------------------------------------------------------ #

# -- Atelier Governance Bypass Toggle
# Values: 0 (enforce 3-layer ceiling and zero-emoji invariants) | 1 (bypass pre-tool-use hook)
MESH_ALLOW_UNSAFE_ATELIER=<YOUR_MESH_ALLOW_UNSAFE_ATELIER>


# ------------------------------------------------------------------------------ #
# 7. AGENT MESH ORCHESTRATION & CORTEX GATEWAY
# ------------------------------------------------------------------------------ #

# -- Mesh Execution Profile
# Profiles:
#   local   - Spawns local stdio MCP processes and monorepo TypeScript binaries directly.
#   cluster - Routes tool invocations to the centralized Kubernetes Cortex Gateway via mcp-remote.
MESH_PROFILE=<YOUR_MESH_PROFILE>

# -- Central Cortex MCP Gateway URL (Used when MESH_PROFILE=cluster)
CORTEX_GATEWAY_URL=<YOUR_CORTEX_GATEWAY_URL>

# -- Cortex Gateway Cluster Mode Switch
# Values: true (forces cluster gateway routing) | false (uses local stdio bundles)
CORTEX_GATEWAY_ENABLED=<YOUR_CORTEX_GATEWAY_ENABLED>

# -- Enterprise Gateway Ingress Token
# Bearer token used to authenticate against the cluster agent gateway.
VITORIA_GATEWAY_TOKEN=<YOUR_VITORIA_GATEWAY_TOKEN>

# -- Node Execution Environment
# Values: development | production
NODE_ENV=<YOUR_NODE_ENV>

# -- Agent Shared Data Directory
# Base directory for browser profiles, candidate resumes, and local runtime storage.
# Defaults to ~/.antigravity/data if unset.
PLUGIN_DATA=<YOUR_PLUGIN_DATA>
